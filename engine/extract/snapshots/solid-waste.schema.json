  "required": [
    "persons",
    "organizations",
    "locations",
    "events",
    "lgus",
    "barangays",
    "haulers",
    "contracts",
    "facilities",
    "vehicles",
    "inspections",
    "complaints",
    "relationships"
  ],
  "additionalProperties": false
}
