          "plateNo"
        ],
        "additionalProperties": false
      }
    },
    "inspections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "agency": {
            "type": "string"
          },
          "facility": {
            "type": "string"
          },
          "hauler": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "when": {
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      }
    },
    "complaints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "barangay": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "when": {
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fromName": {
            "type": "string"
          },
          "fromType": {
            "type": "string",
            "enum": [
              "Person",
              "Organization",
              "Location",
              "Event",
              "LGU",
              "Barangay",
              "Hauler",
              "Contract",
              "Facility",
              "Vehicle",
              "Inspection",
              "Complaint"
            ]
          },
          "toName": {
            "type": "string"
          },
          "toType": {
            "type": "string",
            "enum": [
              "Person",
              "Organization",
              "Location",
              "Event",
              "LGU",
              "Barangay",
              "Hauler",
              "Contract",
              "Facility",
              "Vehicle",
              "Inspection",
              "Complaint"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "took",
              "owns",
              "registered_to",
              "custodian_of",
              "recovered_at",
              "matched_to",
              "member_of",
              "groomed_by",
              "messaged",
              "co_planned",
              "posted",
              "attends",
              "teaches_at",
              "guardian_of",
              "relative_of",
              "investigated",
              "treated_at",
              "located_at",
              "part_of",
              "contracted_by",
              "serves",
              "operates",
              "inspected",
              "filed_against",
              "awarded_to",
              "logged_at",
              "mentions"
            ]
          },
          "when": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "fromName",
          "fromType",
          "toName",
          "toType",
          "kind",
          "confidence"
        ],
        "additionalProperties": false
      }
    }
